DATABASE_URL="postgresql://gbairai:gbairai@localhost:5432/gbairai"
JWT_SECRET="change_this_to_a_long_random_string"
JWT_REFRESH_SECRET="change_this_too"
PORT=4000
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:4000"

# Google OAuth — create a project at https://console.cloud.google.com
# Enable "Google+ API" and add http://localhost:4000/api/auth/google/callback as redirect URI
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Création de quiz par IA (Claude, API Anthropic). Clé = crédits API
# (console.anthropic.com), distincts d'un abonnement Claude. Vide = fonction désactivée.
ANTHROPIC_API_KEY=""
# Modèle : claude-haiku-5-5 (défaut, le moins cher), claude-sonnet-5-5 ou
# claude-opus-5-5 (≈ 40 fois plus cher que Haiku — voir docs/GENERATION_IA.md).
IA_MODELE="claude-haiku-5-5"
# Anti-abus : appels par heure et par compte ; plafond de dépense quotidien global (USD).
IA_REQUETES_PAR_HEURE=10
IA_BUDGET_JOUR_USD=5.00
