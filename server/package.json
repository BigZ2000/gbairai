{
  "name": "gbairai-server",
  "version": "1.0.0",
  "description": "Gbairai - Serveur de jeux concours avec buzzers connectés",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed-full.js",
    "test": "node --test --test-force-exit tests/quizGenerator.test.js",
    "test:integration": "node --test --test-force-exit tests/quiz.integration.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed-full.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@prisma/client": "^5.10.0",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^5.10.0"
  }
}
